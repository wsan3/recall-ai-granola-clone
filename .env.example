# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

# Recall.ai
# Region this workspace's API key belongs to. Must match the dashboard/API key region exactly.
# One of: us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_REGION=us-west-2
RECALL_API_KEY=
# Created in the Recall dashboard (Settings > Developers) in the same region as above.
# Used to verify incoming webhook signatures.
RECALL_WORKSPACE_VERIFICATION_SECRET=

# Publicly reachable base URL for the backend (e.g. a static ngrok domain in dev).
# Recall's webhooks are delivered here. Must not be localhost or a private IP.
PUBLIC_API_BASE_URL=

# OpenAI (used for the post-call notes synthesis pass)
OPENAI_API_KEY=

# Backend
PORT=3000
DATABASE_URL="file:./dev.db"
